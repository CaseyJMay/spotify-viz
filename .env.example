# Optional configuration. The app ships with a bundled Spotify client ID and
# works out of the box for allow-listed users. Without any Spotify access it
# still runs in audio-only mode (no track card / playback controls).

# Use your OWN Spotify app instead of the bundled one (PKCE, no secret needed).
# Create an app at https://developer.spotify.com/dashboard and register the
# redirect URI below. Leave commented to use the bundled default.
# SPOTIPY_CLIENT_ID=your_own_client_id

# Must exactly match a Redirect URI registered on the Spotify app in use.
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Change the server port (default 5000).
# PORT=5000
